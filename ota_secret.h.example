// Vorlage für das Funk-Update der Badges (ab Badge-FW 1.7.0).
// Als ota_secret.h neben Herz_Schwarm_CCC_V.ino kopieren und alle drei Werte ändern.
// ota_secret.h steht in .gitignore und gehört nicht ins Repo.
//
// Ohne ota_secret.h baut die Firmware ganz ohne Funk-Update (Modus 13 wird ignoriert).
// Ein Badge, das per Funk-Update eine ohne diese Datei gebaute Firmware bekommt, kann
// danach nicht mehr per Funk aktualisiert werden — Update-Dateien also immer mit ihr bauen.

// WLAN, an dem sich die Badges für das Update anmelden (2,4 GHz). Der Rechner mit der
// Herz-Schwarm-App (Pi) muss in diesem WLAN erreichbar sein.
#define OTA_WIFI_SSID "herz-ota"
#define OTA_WIFI_PASS "hier-ein-eigenes-wlan-passwort"

// Gemeinsamer Schlüssel von Badges und App (dort: Umgebungsvariable BADGE_OTA_KEY mit
// genau demselben Text). Nur wer ihn kennt, kann ein Update auslösen. Lang und zufällig wählen.
#define OTA_KEY "hier-einen-langen-zufaelligen-schluessel-eintragen"
